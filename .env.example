# ==============================================================================
# ShadowTwin — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in your API keys and configuration values.
# 3. NEVER commit your actual .env file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
# Environment mode: development, test, or production
NODE_ENV=development

# Server listening port (default: 3000)
PORT=3000

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Core Provider Credentials (REQUIRED)
# ------------------------------------------------------------------------------
# TinyFish API key for Explorer and Recovery agents (get from https://agent.tinyfish.ai/api-keys)
# REQUIRED: Must not be blank in non-test mode.
TINYFISH_API_KEY=

# ------------------------------------------------------------------------------
# LLM Provider Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional LLM API key for Compiler Agent diagnostics/critique
LLM_API_KEY=

# LLM model identifier (default: gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Persistence & Storage
# ------------------------------------------------------------------------------
# Path to local SQLite database file
DATABASE_URL=data/shadowtwin.db

# ------------------------------------------------------------------------------
# Security, Domain Boundary & SSRF Protection
# ------------------------------------------------------------------------------
# Comma-separated list of permitted target domains for browser navigation
# Strictly blocks all unauthorized domains, cloud metadata endpoints, and private IPs
ALLOWED_TARGET_DOMAINS=robu.in,makerbazar.in,books.toscrape.com,webscraper.io,amazon.in,amazon.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Agent Budgets, Concurrency & Timeouts
# ------------------------------------------------------------------------------
# Maximum concurrent TinyFish exploration sessions (default: 2)
MAX_CONCURRENT_EXPLORERS=2

# Maximum agent runs permitted per job to prevent runaway loops (default: 4)
MAX_AGENT_RUNS_PER_JOB=4

# Maximum execution timeout in seconds per job (default: 300)
JOB_TIMEOUT_SECONDS=300

# Maximum execution timeout in seconds per browser step (default: 30)
STEP_TIMEOUT_SECONDS=30

