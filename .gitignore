# ==============================================================================
# ShadowTwin — Git Ignore Rules
# ==============================================================================

# Secrets & Environment Variables (STRICT)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Explicitly preserve safe configuration template
!.env.example

# Node Dependencies & Compiled Output
node_modules/
dist/
build/
.cache/

# Test & Coverage Outputs
coverage/
.vitest/

# Local Persistence & Databases
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# Browser Traces, Screenshots & Profiles
traces/
recordings/
screenshots/
.playwright/
browser-profiles/

# Logs & Runtime Artefacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
